{
  "name": "gridguide",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:seed-geo": "node prisma/seed-geo.js",
    "db:migrate:prod": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force && node prisma/seed.js",
    "setup": "bash scripts/setup.sh",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose up --build",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/payments/webhook",
    "postinstall": "prisma generate",
    "db:seed:dev": "node prisma/seed.dev.js",
    "db:seed:vpp": "node prisma/seed-vpp-providers.js",
    "db:seed:geo": "node prisma/seed-geo.js",
    "db:seed:utilities": "node prisma/seed-utilities.js",
    "verify:env": "node scripts/verify-env.js",
    "test:geothermal": "node --test tests/geothermal-metrics.test.mjs",
    "predeploy": "npm run verify:env && npm run db:migrate:prod"
  },
  "dependencies": {
    "next": "14.2.0",
    "react": "18.3.0",
    "react-dom": "18.3.0",
    "@prisma/client": "5.14.0",
    "stripe": "15.8.0",
    "jsonwebtoken": "9.0.2",
    "bcryptjs": "2.4.3",
    "redis": "4.6.14",
    "axios": "1.7.2",
    "zod": "3.23.8",
    "@anthropic-ai/sdk": "0.24.3",
    "nodemailer": "6.9.14",
    "twilio": "5.2.2",
    "uuid": "10.0.0",
    "nanoid": "5.0.7",
    "date-fns": "3.6.0",
    "cors": "2.8.5",
    "@aws-sdk/client-s3": "3.600.0",
    "@aws-sdk/s3-request-presigner": "3.600.0",
    "@sendgrid/mail": "8.1.3",
    "@sentry/nextjs": "8.11.0",
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "prisma": "5.14.0",
    "@types/node": "20.14.0",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.0"
  }
}
