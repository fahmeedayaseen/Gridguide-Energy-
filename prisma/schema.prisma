generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  name                 String
  phone                String?
  avatar               String?
  role                 UserRole  @default(CONSUMER)
  plan                 Plan      @default(HOMEOWNER_FREE)
  planExpiresAt        DateTime?
  emailVerified        Boolean   @default(false)
  twoFactorEnabled     Boolean   @default(false)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  subscriptionStatus   String?   @default("inactive")
  currentPeriodEnd     DateTime? @unique
  membershipStatus     String?   @default("active")
  creditBalance        Float     @default(0)

  // Signup & onboarding tracking
  signupSource         String? // web | mobile | referral | installer | seller
  utmSource            String? // utm_source value
  utmCampaign          String? // utm_campaign value
  referralCode         String? // referral code used at signup
  personalReferralCode String? @unique // homeowner share code for invite credits
  referredByUserId     String? // user who referred them
  homeAddress          String? // full formatted address from signup step 2
  homeZip              String?
  homeState            String?
  onboardingStep       Int     @default(0) // 0=incomplete, 4=fully onboarded
  onboardingCompleted  Boolean @default(false)
  utilityConnected     Boolean @default(false)
  utilityProvider      String? // name of connected utility

  // Activity tracking
  lastLoginAt    DateTime?
  lastActiveAt   DateTime?
  sessionCount   Int       @default(0)
  totalAiChats   Int       @default(0)
  totalVppEvents Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sessions                  Session[]
  orders                    Order[]
  devices                   Device[]
  thermostat                Thermostat?
  vppEnrollment             VppEnrollment?
  vppPayouts                VppPayout[]
  rewards                   Reward?
  rebateClaims              RebateClaim[]
  sellerMessagesSent        SellerMessage[]          @relation("SellerMessageBuyer")
  rewardGrants              RewardGrant[]
  aiChats                   AiChat[]
  notifications             Notification[]
  addressVerifications      AddressVerification[]
  rewardRedemptions         RewardRedemption[]
  wallet                    Wallet?
  withdrawals               Withdrawal[]
  gridFundDonations         GridFundDonation[]
  installer                 Installer?
  seller                    Seller?
  organizations             OrganizationMember[]
  ownedOrganizations        Organization[]           @relation("OrganizationOwner")
  properties                Property[]
  utilityAccounts           UtilityAccount[]
  utilityConnectionEvents   UtilityConnectionEvent[]
  integrationConnections    IntegrationConnection[]
  revenueTransactions       RevenueTransaction[]
  paymentCards              PaymentCard[]
  payoutPreference          PayoutPreference?
  siteSurveys               SiteSurvey[]
  quoteChangeRequests       QuoteChangeRequest[]
  vppEnrollmentLogs         VppEnrollmentLog[]
  vppProgramEnrollments     VppProgramEnrollment[]
  vppEventParticipations    VppEventParticipation[]
  vppRevenueSplits          VppRevenueSplit[]
  communityPosts            CommunityPost[]
  communityLikes            CommunityLike[]
  enterpriseSponsorship     EnterpriseSponsorship?
  enterpriseTeamMemberships EnterpriseTeamMember[]
  badges                    UserBadge[]
  communityReplies          CommunityReply[]
  signupEvents              SignupEvent[]
  activityLogs              UserActivityLog[]
  installerReferrals        InstallerReferral[]
  referralsMade             HomeownerReferral[]      @relation("HomeownerReferralsMade")
  referralsReceived         HomeownerReferral[]      @relation("HomeownerReferralsReceived")
  creditAccount             CreditAccount?
  creditRedemptions         CreditRedemption[]
  enterpriseOrg             EnterpriseOrg?
  sellerTeamMembers         SellerTeamMember[]

  @@index([email])
}

enum UserRole {
  CONSUMER
  INSTALLER
  SELLER
  ENTERPRISE
  ADMIN
}

enum Plan {
  HOMEOWNER_FREE
  HOMEOWNER_PLUS
  HOMEOWNER_PREMIUM
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Seller {
  id                 String             @id @default(cuid())
  userId             String             @unique
  businessName       String
  category           String
  description        String?
  website            String?
  licenseNumber      String?
  taxId              String?
  verificationStatus VerificationStatus @default(PENDING)
  plan               SellerPlan         @default(FREE)
  commissionRate     Float              @default(0.10) // 10% free, 7% pro, 5% enterprise

  // ── Enterprise co-branded storefront fields ──────────────────────────────
  // These are enabled only on the ENTERPRISE plan. GridGuide branding is
  // not removed — the storefront is co-branded "ABC Solar — Powered by GridGuide."
  storefrontSlug       String? @unique // e.g. "abc-solar" → marketplace.gridguide.ai/s/abc-solar
  storefrontLogoUrl    String? // seller's logo displayed in their storefront header
  storefrontBannerUrl  String? // hero banner image for their custom landing page
  storefrontBrandColor String? // primary accent color (hex) for their storefront
  storefrontTagline    String? // short tagline shown under their business name
  customDomainEnabled  Boolean @default(false) // admin-approved CNAME mapping
  customDomain         String? // e.g. "shop.abcsolar.com" — points via CNAME to GG
  teamEnabled          Boolean @default(false) // Enterprise: multiple seller users under one account

  stripeAccountId      String?  @unique
  stripeSubscriptionId String?
  totalSales           Float    @default(0)
  totalPayouts         Float    @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  products          Product[]
  payouts           SellerPayout[]
  messages          SellerMessage[]
  sellerCustomers   SellerCustomer[]
  sellerCampaigns   SellerCampaign[]
  sellerQuotes      SellerQuote[]
  sellerMessages    SellerMessageLog[]
  sellerTeamMembers SellerTeamMember[]
  SellerFulfillment SellerFulfillment[]
}

enum SellerPlan {
  FREE // $0/mo — limited listings, standard storefront, basic analytics
  PRO // $99/mo — unlimited listings, featured placement, advanced analytics
  ENTERPRISE // $499/mo — co-branded storefront, team accounts, API, ERP/CRM integrations
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

model Installer {
  id                 String             @id @default(cuid())
  userId             String             @unique
  companyName        String
  licenseNumber      String
  nabcepCertified    Boolean            @default(false)
  insuranceVerified  Boolean            @default(false)
  backgroundChecked  Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  plan               InstallerPlan      @default(FREE)
  successFeeRate     Float              @default(0.10) // Free-tier lead success fee; set from lib/installer-plans.js on every plan change
  rating             Float              @default(0)
  reviewCount        Int                @default(0)
  jobsCompleted      Int                @default(0)
  totalEarnings      Float              @default(0)
  stripeAccountId    String?            @unique
  serviceAreas       String[]
  specialties        String[]
  notificationPrefs  Json? // {leads, jobs, reviews, payments} booleans from Installer → Settings

  // Revenue partner / referral program
  referralCode             String? @unique // installer's personal referral code
  totalReferredUsers       Int     @default(0) // homeowners referred to GridGuide
  activeReferredUsers      Int     @default(0) // currently on paid plan
  revenueSharePct          Float   @default(0.15) // 15% Free, 25% Pro, 30% Enterprise
  lifetimeReferralEarnings Float   @default(0)
  monthlyReferralEarnings  Float   @default(0)
  vppSharePct              Float   @default(0) // installer share of VPP event revenue: Free 0% | Pro 5% | Enterprise 10%

  // Membership billing
  membershipMonthlyFee Float     @default(0) // 0 | 99 | 499
  membershipStatus     String    @default("active")
  membershipRenewsAt   DateTime?
  trialEndsAt          DateTime? // set for Pro plans: 14 days from upgrade; null for Free/Enterprise
  stripeSubscriptionId String?

  // Territory & CRM
  territories    String[] // Geographic territories claimed
  totalPortfolio Int      @default(0) // total past customers in CRM

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads                InstallerLead[]
  reviews              InstallerReview[]
  payouts              InstallerPayout[]
  jobs                 Job[]
  location             InstallerLocation?
  siteSurveys          SiteSurvey[]
  quoteChangeRequests  QuoteChangeRequest[]
  referrals            InstallerReferral[]
  revenueShares        InstallerRevenueShare[]
  vppEarnings          InstallerVppEarning[]
  revenueRules         VppRevenueRule[]
  homeownerInvites     EnterpriseHomeownerInvite[]
  enterpriseNetwork    EnterpriseInstallerNetwork[]
  proposals            Proposal[]
  interconnectionTasks InterconnectionTask[]
  permits              Permit[]
  certifications       InstallerCertification[]
  serviceZones         ServiceZone[]
  commissionLedger     InstallerCommissionLedger[]
  customerInvites      InstallerCustomerInvite[]
  importBatches        InstallerImportBatch[]
  campaigns            InstallerCampaign[]
}

enum InstallerPlan {
  FREE // $0/mo — 15% homeowner revenue share, basic features
  PRO // $99/mo — 25% homeowner revenue share, lead tools, priority listing
  ENTERPRISE // $499/mo — 30% revenue share, multi-user, territory mgmt, API access, white-label
}

model Product {
  id             String          @id @default(cuid())
  sellerId       String
  name           String
  description    String
  category       ProductCategory
  price          Float
  salePrice      Float?
  sku            String?         @unique
  inventory      Int             @default(0)
  images         String[]
  specs          Json?
  rebateEligible Boolean         @default(false)
  rebateAmount   Float?
  status         ProductStatus   @default(PENDING_REVIEW)
  featured       Boolean         @default(false)
  viewCount      Int             @default(0)
  soldCount      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  seller     Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  messages   SellerMessage[]

  @@index([category])
  @@index([status])
}

enum ProductCategory {
  SOLAR
  BATTERY
  EV_CHARGING
  SMART_PANEL
  THERMOSTAT
  MONITORING
  ACCESSORIES
}

enum ProductStatus {
  PENDING_REVIEW
  ACTIVE
  INACTIVE
  REJECTED
}

model Order {
  id                 String              @id @default(cuid())
  userId             String
  status             OrderStatus         @default(PENDING)
  subtotal           Float
  commission         Float
  processingFee      Float
  total              Float
  stripePaymentId    String?             @unique
  stripeSessionId    String?
  trackingNumber     String?
  carrier            String?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  refundedAt         DateTime?
  refundAmount       Float?
  cancellationReason String?
  fulfillments       SellerFulfillment[]
  shippingAddress    Json?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user    User           @relation(fields: [userId], references: [id])
  items   OrderItem[]
  payouts SellerPayout[]
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  REFUNDED
  CANCELLED
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model SellerMessage {
  id        String   @id @default(cuid())
  sellerId  String // the seller receiving the message
  buyerId   String // the homeowner/buyer who sent it
  productId String? // the product the message is about (optional)
  body      String
  read      Boolean  @default(false) // has the seller read it?
  replyTo   String? // parent message id for threading
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller  Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  buyer   User     @relation("SellerMessageBuyer", fields: [buyerId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([sellerId, createdAt(sort: Desc)])
  @@index([buyerId])
}

model InstallerLead {
  id             String     @id @default(cuid())
  installerId    String
  customerName   String
  customerEmail  String
  customerPhone  String?
  address        String
  projectType    String
  projectSize    Float?
  notes          String?
  status         LeadStatus @default(NEW)
  estimatedValue Float?
  successFee     Float?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  installer Installer  @relation(fields: [installerId], references: [id])
  job       Job?
  proposals Proposal[]
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  CONVERTED
  LOST
}

model Job {
  id                    String    @id @default(cuid())
  installerId           String
  leadId                String?   @unique
  title                 String
  description           String?
  address               String
  scheduledAt           DateTime?
  completedAt           DateTime?
  projectValue          Float
  successFee            Float
  successFeeRate        Float     @default(0.10) // plan-tiered lead success fee: Free 10% | Pro 7% | Enterprise 5%; 0 fee for self-sourced jobs
  status                JobStatus @default(SCHEDULED)
  jobType               String? // solar|battery|ev_charger|smart_panel|site_survey
  permitStatus          String    @default("not_started")
  interconnectionStatus String    @default("not_started")
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  installer            Installer             @relation(fields: [installerId], references: [id])
  lead                 InstallerLead?        @relation(fields: [leadId], references: [id])
  payout               InstallerPayout?
  interconnectionTasks InterconnectionTask[]
  permits              Permit[]
}

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

model InstallerReview {
  id          String   @id @default(cuid())
  installerId String
  rating      Int // 1-5
  comment     String?
  jobType     String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  installer Installer @relation(fields: [installerId], references: [id])
}

model Device {
  id     String @id @default(cuid())
  userId String

  // Normalized integration identity. Stored as strings so each provider can map
  // its own device types without breaking the schema. Examples: solar, battery,
  // ev_charger, smart_panel, thermostat, meter, energy_monitor, smart_plug.
  type         String
  brand        String? // tesla | enphase | solaredge | span | emporia | derapi | smartthings | alexa | nest | ecobee
  name         String?
  externalId   String?
  capabilities Json?

  manufacturer String?
  model        String?
  serialNumber String?
  derApiId     String? // Derapi device ID
  status       DeviceStatus @default(ACTIVE)
  lastReading  Json? // Latest telemetry
  lastSeenAt   DateTime?
  lastSyncAt   DateTime?

  // Provider tokens are server-only. Encrypt at the application/hosting layer before launch.
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?

  // Extended device tracking
  firmwareVersion         String?
  capacityKwh             Float? // For batteries and EVs
  capacityKw              Float? // For solar inverters
  locationNote            String? // e.g. "Garage", "Roof south-facing"
  vppEligible             Boolean   @default(false)
  vppEnrolledAt           DateTime?
  installedAt             DateTime?
  installedBy             String? // installer company name or ID
  connectedVia            String? // derapi | tesla | enphase | solaredge | span | emporia | smartthings | alexa | manual | upload
  integrationConnectionId String?
  isOnline                Boolean   @default(true)
  totalEnergyKwh          Float     @default(0) // lifetime kWh

  // Enterprise Portal fleet management: a device may optionally belong to a
  // property in an Enterprise org's portfolio, in addition to its owning User.
  enterprisePropertyId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrationConnection IntegrationConnection? @relation(fields: [integrationConnectionId], references: [id], onDelete: SetNull)
  vppEnrollment         VppEnrollment?         @relation(fields: [userId], references: [userId], map: "Device_vppEnrollment_userId_fkey")
  enterpriseProperty    EnterpriseProperty?    @relation(fields: [enterprisePropertyId], references: [id], onDelete: SetNull)
  readings              DeviceReading[]

  @@unique([externalId, userId])
  @@index([userId])
  @@index([brand])
  @@index([type])
  @@index([integrationConnectionId])
  @@index([enterprisePropertyId])
}

model DeviceReading {
  id         String   @id @default(cuid())
  deviceId   String
  reading    Json // same shape as Device.lastReading at capture time
  recordedAt DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, recordedAt])
}

enum DeviceType {
  SOLAR_INVERTER
  BATTERY
  EV_CHARGER
  SMART_PANEL
  THERMOSTAT
  WATER_HEATER
  SMART_PLUG
  ENERGY_MONITOR
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  ERROR
  PENDING
}

model Thermostat {
  id              String    @id @default(cuid())
  userId          String    @unique
  brand           String // ecobee | nest | honeywell | sensi | derapi
  externalId      String // Brand device ID
  accessToken     String? // Encrypted
  refreshToken    String? // Encrypted
  currentTemp     Float?
  targetTemp      Float?
  humidity        Float?
  mode            String    @default("cool") // cool|heat|auto|off
  aiOptimize      Boolean   @default(true)
  vppPreCondition Boolean   @default(true)
  awayMode        Boolean   @default(false)
  schedule        Json? // Array of schedule slots
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum VppEventStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

model VppEvent {
  id               String         @id @default(cuid())
  name             String
  program          String // PG&E Demand Response, SCE DRAM, etc.
  utility          String
  windowStart      DateTime
  windowEnd        DateTime
  utilityPayment   Float
  gridguideFee     Float // 10%
  netPool          Float // utilityPayment - gridguideFee
  totalKwh         Float? // Verified after event
  participantCount Int            @default(0)
  status           VppEventStatus @default(SCHEDULED)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  payouts             VppPayout[]
  InstallerVppEarning InstallerVppEarning[]
}

model VppRevenueRule {
  id   String @id @default(cuid())
  name String // human label, e.g. "Default Enterprise Split", "Acme HOA negotiated rate"

  vppProgram      String? // matches VppEvent.program, exact match, e.g. "PG&E Demand Response"
  utility         String? // matches VppEvent.utility, exact match
  enterpriseOrgId String? // applies when the homeowner's device is on this org's property
  installerId     String? // applies when the homeowner has an active referral to this installer

  homeownerPct Float
  gridguidePct Float
  partnerPct   Float @default(0) // goes to whichever partner matched (enterprise org or installer)

  priority        Int      @default(0) // tiebreaker when multiple rules match with equal specificity
  isActive        Boolean  @default(true)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  enterpriseOrg EnterpriseOrg? @relation(fields: [enterpriseOrgId], references: [id], onDelete: Cascade)
  installer     Installer?     @relation(fields: [installerId], references: [id], onDelete: Cascade)

  @@index([enterpriseOrgId])
  @@index([installerId])
  @@index([vppProgram])
  @@index([utility])
}

model VppEnrollment {
  id         String   @id @default(cuid())
  userId     String   @unique
  active     Boolean  @default(true)
  enrolledAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  devices Device[]
  payouts VppPayout[]
}

model VppPayout {
  id               String       @id @default(cuid())
  userId           String
  eventId          String
  enrollmentId     String
  kwhDispatched    Float
  sharePct         Float // User's % of total event kWh
  grossAmount      Float // Before GridGuide fee
  fee              Float // GridGuide 10%
  netAmount        Float // What user receives
  status           PayoutStatus @default(PENDING)
  stripeTransferId String?
  settledAt        DateTime?
  createdAt        DateTime     @default(now())

  user       User          @relation(fields: [userId], references: [id])
  event      VppEvent      @relation(fields: [eventId], references: [id])
  enrollment VppEnrollment @relation(fields: [enrollmentId], references: [id])

  @@index([userId])
  @@index([eventId])
}

model SellerPayout {
  id               String       @id @default(cuid())
  sellerId         String
  orderId          String
  grossAmount      Float
  commission       Float
  processingFee    Float
  netAmount        Float
  status           PayoutStatus @default(PENDING)
  stripeTransferId String?
  scheduledFor     DateTime?
  settledAt        DateTime?
  createdAt        DateTime     @default(now())

  seller Seller @relation(fields: [sellerId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])
}

model InstallerPayout {
  id               String       @id @default(cuid())
  installerId      String
  jobId            String       @unique
  projectValue     Float
  successFee       Float
  netAmount        Float
  status           PayoutStatus @default(PENDING)
  stripeTransferId String?
  scheduledFor     DateTime?
  settledAt        DateTime?
  createdAt        DateTime     @default(now())

  installer Installer @relation(fields: [installerId], references: [id])
  job       Job       @relation(fields: [jobId], references: [id])
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

model RebateClaim {
  id             String      @id @default(cuid())
  userId         String
  programId      String?
  programName    String
  programType    String?
  category       String?
  amount         Float       @default(0)
  productType    String?
  zipCode        String?
  status         ClaimStatus @default(PENDING)
  documents      String[]
  applicantName  String?
  applicantPhone String?
  installerName  String?
  installDate    DateTime?
  systemKw       Float?
  notes          String?
  submittedAt    DateTime    @default(now())
  processedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([programId])
}

enum ClaimStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAID
  CLAIMED
  EXPIRED
}

model Reward {
  id               String   @id @default(cuid())
  userId           String   @unique
  points           Int      @default(0)
  tier             String   @default("Bronze") // Bronze|Silver|Gold|Platinum
  lifetimePoints   Int      @default(0)
  lifetimeRedeemed Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions RewardTransaction[]
  redemptions  RewardRedemption[]
}

model RewardTransaction {
  id        String   @id @default(cuid())
  rewardId  String
  points    Int // positive = earned, negative = redeemed
  reason    String
  type      String?
  metadata  Json?
  createdAt DateTime @default(now())

  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
}

model AiChat {
  id        String   @id @default(cuid())
  userId    String
  messages  Json // Array of {role, content, timestamp}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ZipCode {
  id        String   @id @default(cuid())
  zip       String   @unique
  city      String
  state     String   @db.Char(2)
  county    String?
  lat       Float
  lng       Float
  timezone  String?
  utilityId String?
  createdAt DateTime @default(now())

  utility UtilityTerritory? @relation(fields: [utilityId], references: [id])

  @@index([zip])
  @@index([state])
  @@index([lat, lng])
}

model UtilityTerritory {
  id        String  @id @default(cuid())
  name      String // "Pacific Gas and Electric"
  shortName String // "PG&E"
  state     String
  eiaid     String? @unique // EIA utility ID
  type      String // IOU | Cooperative | Municipal | Transmission
  iso       String? // CAISO | ERCOT | PJM | MISO | NYISO | ISONE | SPP | FRCC | SERC | WECC

  // Contact / self-service links (Phase 1: "website, customer portal URL")
  website           String?
  customerPortalUrl String?
  phone             String?

  // ── Connection method support (Phase 1 + drives Phase 2 routing order) ──
  // Routing preference, in order, is: Green Button -> Arcadia -> direct API -> manual/bill upload.
  // See lib/utility-routing.js for the actual decision function.
  supportsGreenButton       Boolean                @default(false)
  supportsArcadia           Boolean                @default(false)
  supportsDirectApi         Boolean                @default(false)
  supportsManualUpload      Boolean                @default(true) // always true in practice — the universal fallback
  // Admin override: force a specific method regardless of the flags above (e.g. a utility
  // whose Green Button feed is known to be unreliable can be temporarily pinned to ARCADIA).
  preferredConnectionMethod UtilityConnectionType?
  greenButtonAuthUrl        String? // utility's "Share My Data" / Green Button Connect authorization URL
  arcadiaUtilityId          String? // Arcadia's internal utility identifier, if supported via Arcadia
  directApiProvider         String? // "utilityapi" | "bayou" | a named direct integration
  directApiBaseUrl          String?

  // ── Program eligibility flags surfaced by the AI Utility Router (Phase 5) ──
  vppEligible             Boolean @default(false)
  netMeteringAvailable    Boolean @default(false)
  touRatesAvailable       Boolean @default(false)
  demandResponseAvailable Boolean @default(false)

  isActive Boolean @default(true) // admin can disable a utility without deleting its history
  notes    String? @db.Text

  // Bounding box for fast pre-filter before PostGIS
  minLat      Float?
  maxLat      Float?
  minLng      Float?
  maxLng      Float?
  // WKT polygon stored as text (full territory boundary)
  boundaryWkt String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  zipCodes         ZipCode[]
  programs         UtilityProgram[]
  incentives       UtilityIncentive[]
  ratePlans        UtilityRatePlan[]
  connectionEvents UtilityConnectionEvent[]

  @@index([state])
  @@index([isActive])
}

enum UtilityProgramCategory {
  DEMAND_RESPONSE
  VPP
  SOLAR
  BATTERY
  EV
  ENERGY_EFFICIENCY
}

model UtilityProgram {
  id          String                 @id @default(cuid())
