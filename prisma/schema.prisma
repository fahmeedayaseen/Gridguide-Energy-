}

enum UtilityIncentiveCategory {
  FEDERAL_TAX_CREDIT
  STATE_TAX_CREDIT
  STATE_REBATE
  UTILITY_REBATE
  NET_METERING
  PROPERTY_TAX
  SALES_TAX
