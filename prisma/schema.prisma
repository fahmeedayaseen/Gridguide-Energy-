model InstallerReferral {
  id               String    @id @default(cuid())
  installerId      String
  userId           String // The referred homeowner
  referralCode     String
  referredAt       DateTime  @default(now())
  conversionStatus String    @default("referred") // referred | activated | subscribed | churned
  activatedAt      DateTime?
  subscribedAt     DateTime?
  churnedAt        DateTime?
  userPlan         String    @default("HOMEOWNER_FREE") // homeowner's current plan
  monthlyRevenue   Float     @default(0) // homeowner's subscription amount
  installerShare   Float     @default(0) // installer's monthly cut
  lifetimeValue    Float     @default(0) // total paid to installer from this referral
  sourceType       String    @default("signup") // signup | import | qr_code | link
  // A referral created by the real signup-with-code flow (app/api/auth/register)
  // is auto-verified, since the referral code itself is real proof. A referral
  // self-reported by an installer (manual add or bulk import, via
  // POST /api/installers/referrals) is NOT proof of any real relationship and
  // starts unverified - the commission-calculation path (see
  // payments/webhook/route.js) will never pay out for an unverified referral,
  // regardless of what the homeowner's own subscription later does. Verified
  // by either the claimed homeowner confirming the relationship, or an admin
  // approving it.
  verified         Boolean   @default(false)
  verifiedAt       DateTime?
  verifiedByUserId String? // the homeowner who confirmed, or the admin who approved
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  installer        Installer                   @relation(fields: [installerId], references: [id], onDelete: Cascade)
  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  commissionLedger InstallerCommissionLedger[]

  @@unique([installerId, userId])
  @@index([installerId])
  @@index([userId])
  @@index([referralCode])
  @@index([conversionStatus])
  @@index([verified])
}

