  failedCount Int            @default(0)
  queuedAt    DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  installer Installer                 @relation(fields: [installerId], references: [id], onDelete: Cascade)
  invites   InstallerCustomerInvite[]

  @@index([installerId])
}

model CreditAccount {
  id               String   @id @default(cuid())
  userId           String   @unique
  balance          Int      @default(0) // current spendable credit balance
  lifetimeEarned   Int      @default(0) // total credits ever earned
  lifetimeRedeemed Int      @default(0) // total credits ever redeemed
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]
  redemptions  CreditRedemption[]

  @@index([userId])
}

model CreditTransaction {
  id              String   @id @default(cuid())
  creditAccountId String
  amount          Int // positive = earned, negative = redeemed
  reason          String // "referral_signup" | "referral_subscribed" | "redemption" | "admin_adjustment" | "promo"
  metadata        Json?
  createdAt       DateTime @default(now())

  creditAccount CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Cascade)

  @@index([creditAccountId])
  @@index([reason])
}

model RewardGrant {
  id        String   @id @default(cuid())
  userId    String
  rewardKey String // unique identifier for this reward event
  credits   Int // credits awarded (for audit)
  reason    String // matches CreditTransaction.reason
  metadata  Json?
  grantedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rewardKey]) // THE hard stop — DB-level uniqueness
  @@index([userId])
  @@index([rewardKey])
}

model InstallerCommissionLedger {
  id                  String    @id @default(cuid())
  installerId         String
  installerReferralId String
  periodMonth         Int
  periodYear          Int
  planAtBilling       String // FREE | PRO | ENTERPRISE — installer's plan THIS cycle
  sharePctApplied     Float // the % actually used for this cycle's calculation
  homeownerRevenue    Float // what the homeowner paid this cycle
  commissionAmount    Float // homeownerRevenue * sharePctApplied
  status              String    @default("PENDING") // PENDING | PAID | FAILED
  paidAt              DateTime?
  stripeTransferId    String?
  createdAt           DateTime  @default(now())

  installer Installer         @relation(fields: [installerId], references: [id], onDelete: Cascade)
  referral  InstallerReferral @relation(fields: [installerReferralId], references: [id], onDelete: Cascade)

  @@unique([installerReferralId, periodMonth, periodYear]) // one commission row per referral per month
  @@index([installerId])
  @@index([periodYear, periodMonth])
  @@index([status])
}

model EnterpriseRequest {
  id            String    @id @default(cuid())
  orgName       String
  contactName   String
  email         String
  phone         String?
  propertyCount Int?
  orgType       String    @default("Property Management") // Property Management | HOA | Commercial Building | Municipality | School/Institution | Energy Consultant | Other
  status        String    @default("pending") // pending | contacted | approved | rejected
  notes         String?
  createdAt     DateTime  @default(now())
  reviewedAt    DateTime?
  reviewedBy    String?

  @@index([status])
  @@index([email])
}

model EnterpriseOrg {
  id                              String   @id @default(cuid())
  name                            String
  plan                            String   @default("ENTERPRISE_BASIC") // ENTERPRISE_BASIC | ENTERPRISE_PRO | ENTERPRISE_SCALE
  contactName                     String
  contactEmail                    String   @unique
  contactPhone                    String?
  ownerUserId                     String?  @unique
  stripeCustomerId                String?
  stripeSubscriptionId            String?
  subscriptionStatus              String?
  whiteLabelEnabled               Boolean  @default(false)
  apiEnabled                      Boolean  @default(false)
  sponsoredSeatLimit              Int      @default(0)
  sponsorshipStripeSubscriptionId String?
  sponsorshipStripeItemId         String?
  billingCycle                    String   @default("MONTHLY") // MONTHLY | ANNUAL
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  owner                  User?                             @relation(fields: [ownerUserId], references: [id])
  properties             EnterpriseProperty[]
  teamMembers            EnterpriseTeamMember[]
  apiKeys                EnterpriseApiKey[]
  auditLogs              EnterpriseAuditLog[]
  revenueRules           VppRevenueRule[]
  deviceLinkRequests     EnterpriseDeviceLinkRequest[]
  homeownerInvites       EnterpriseHomeownerInvite[]
  sponsorships           EnterpriseSponsorship[]
  installerNetwork       EnterpriseInstallerNetwork[]
  energyAssets           EnterpriseEnergyAsset[]
  geothermalPpas         EnterpriseGeothermalPpa[]
  sustainabilityReadings EnterpriseSustainabilityReading[]
  importBatches          EnterpriseImportBatch[]
  campaigns              EnterpriseCampaign[]

  @@index([plan])
}

model EnterpriseProperty {
  id               String   @id @default(cuid())
  orgId            String
  name             String
  address          String?
  type             String   @default("Residential") // Residential | Commercial | Mixed-Use | HOA | Municipal | School/Institution
  units            Int      @default(0)
  kw               Float    @default(0)
  status           String   @default("pending") // pending | active | inactive
  utilityAccountId String?
  createdAt        DateTime @default(now())

  org                    EnterpriseOrg                     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  devices                Device[]
  deviceLinkRequests     EnterpriseDeviceLinkRequest[]
  energyAssets           EnterpriseEnergyAsset[]
  geothermalPpas         EnterpriseGeothermalPpa[]
  sustainabilityReadings EnterpriseSustainabilityReading[]

  @@index([orgId])
  @@index([status])
}

// Enterprise data-center and geothermal energy layer. String classifications
// are intentional so new equipment and contract states can be introduced
// without a PostgreSQL enum migration for every integration partner.
model EnterpriseEnergyAsset {
  id                    String    @id @default(cuid())
  orgId                 String
  propertyId            String?
  name                  String
  type                  String // GEOTHERMAL_GENERATION | GROUND_SOURCE_HEAT_PUMP | THERMAL_STORAGE | BATTERY | UPS | CHILLER | GRID_CONNECTION | SOLAR
  status                String    @default("PLANNED") // PLANNED | CONSTRUCTION | ACTIVE | INACTIVE | RETIRED
  provider              String?
  externalId            String?
  ratedCapacityKw       Float?
  thermalCapacityKwh    Float?
  coolingType           String? // AIR | WATER | HYBRID | CLOSED_LOOP | GROUND_SOURCE | OTHER
  waterSource           String? // MUNICIPAL | RECLAIMED | GROUNDWATER | SURFACE | CLOSED_LOOP | NONE | OTHER
  commercialOperationAt DateTime?
  metadata              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  org      EnterpriseOrg                     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property EnterpriseProperty?               @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  ppas     EnterpriseGeothermalPpa[]
  readings EnterpriseSustainabilityReading[]

  @@unique([orgId, externalId])
  @@index([orgId])
  @@index([propertyId])
  @@index([type])
  @@index([status])
}

model EnterpriseGeothermalPpa {
  id                  String    @id @default(cuid())
  orgId               String
  propertyId          String?
  assetId             String?
  name                String
  seller              String
  utility             String?
  status              String    @default("PROPOSED") // PROPOSED | PENDING_APPROVAL | ACTIVE | EXPIRED | TERMINATED
  contractedMw        Float
  termYears           Int
  capacityFactorPct   Float     @default(90)
  pricePerMwh         Float?
  annualEscalationPct Float?
  signedAt            DateTime?
  deliveryStartAt     DateTime?
  deliveryEndAt       DateTime?
  regulatoryApproval  String? // NOT_REQUIRED | PENDING | APPROVED | REJECTED
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  org      EnterpriseOrg          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property EnterpriseProperty?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  asset    EnterpriseEnergyAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([propertyId])
  @@index([assetId])
  @@index([status])
}

model EnterpriseSustainabilityReading {
  id                           String   @id @default(cuid())
  orgId                        String
  propertyId                   String
  assetId                      String?
  recordedAt                   DateTime
  intervalMinutes              Int      @default(60)
  facilityEnergyKwh            Float    @default(0)
  itEnergyKwh                  Float    @default(0)
  geothermalDeliveredKwh       Float    @default(0)
  gridEnergyKwh                Float    @default(0)
  coolingEnergyKwh             Float    @default(0)
  waterWithdrawnGallons        Float    @default(0)
  waterConsumedGallons         Float    @default(0)
  baselineWaterConsumedGallons Float    @default(0)
  waterRecycledGallons         Float    @default(0)
  carbonAvoidedKg              Float    @default(0)
  source                       String   @default("MANUAL") // MANUAL | CSV | API | METER | DCIM | BMS
  externalId                   String?
  metadata                     Json?
  createdAt                    DateTime @default(now())

  org      EnterpriseOrg          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property EnterpriseProperty     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  asset    EnterpriseEnergyAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@unique([orgId, source, externalId])
  @@index([orgId, recordedAt])
  @@index([propertyId, recordedAt])
  @@index([assetId, recordedAt])
}

model EnterpriseHomeownerInvite {
  id                    String    @id @default(cuid())
  orgId                 String
  email                 String
  firstName             String?
  lastName              String?
  phone                 String?
  address               String?
  city                  String?
  state                 String?
  zip                   String?
  systemType            String?
  batterySystem         Boolean   @default(false)
  utility               String?
  propertyId            String?
  homeownerUserId       String?
  invitedByUserId       String
  invitedViaInstallerId String?
  importBatchId         String?
  campaignId            String?
  status                String    @default("PENDING")
  token                 String    @unique
  sentAt                DateTime?
  openedAt              DateTime?
  clickedAt             DateTime?
  signedUpAt            DateTime?
  subscribedAt          DateTime?
  sendAttempts          Int       @default(0)
  lastAttemptAt         DateTime?
  lastSendError         String?
  createdAt             DateTime  @default(now())
  expiresAt             DateTime
  respondedAt           DateTime?

  org       EnterpriseOrg          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  installer Installer?             @relation(fields: [invitedViaInstallerId], references: [id], onDelete: SetNull)
  batch     EnterpriseImportBatch? @relation(fields: [importBatchId], references: [id])
  campaign  EnterpriseCampaign?    @relation(fields: [campaignId], references: [id])

  @@index([orgId])
  @@index([email])
  @@index([homeownerUserId])
  @@index([status])
  @@index([importBatchId])
}

model EnterpriseSponsorship {
  id                String    @id @default(cuid())
  orgId             String
  userId            String    @unique
  plan              String // "HOMEOWNER_PLUS" | "HOMEOWNER_PREMIUM"
  status            String    @default("ACTIVE") // ACTIVE | PAUSED | ENDED
  startedAt         DateTime  @default(now())
  endedAt           DateTime?
  gracePeriodEndsAt DateTime?

  org  EnterpriseOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([status])
}

model EnterpriseInstallerNetwork {
  id                    String    @id @default(cuid())
  orgId                 String
  installerId           String
  status                String    @default("INVITED")
  invitedAt             DateTime  @default(now())
  installerRespondedAt  DateTime?
  adminApprovedByUserId String?
  adminApprovedAt       DateTime?

  org       EnterpriseOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  installer Installer     @relation(fields: [installerId], references: [id], onDelete: Cascade)

  @@unique([orgId, installerId])
  @@index([orgId])
  @@index([installerId])
  @@index([status])
}

model PlatformAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorRole   String?
  action      String
  targetType  String?
  targetId    String?
  orgId       String?
  category    String // BILLING | ASSIGNMENT | REFERRAL | TEAM | VPP | OTHER
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([orgId])
  @@index([actorUserId])
  @@index([createdAt])
  @@index([action])
  @@index([category])
}

model EnterpriseDeviceLinkRequest {
  id                String    @id @default(cuid())
  orgId             String
  propertyId        String
  homeownerEmail    String // captured at request time
  homeownerUserId   String? // resolved once matched to a real account
  deviceId          String? // set once a device is chosen (by homeowner or admin)
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedByUserId String // the enterprise admin who initiated this
  resolvedByUserId  String? // homeowner or platform admin who resolved it
  resolvedByRole    String? // "HOMEOWNER" | "PLATFORM_ADMIN"
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?

  org      EnterpriseOrg      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property EnterpriseProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([homeownerEmail])
  @@index([homeownerUserId])
  @@index([status])
}

model EnterpriseTeamMember {
  id              String    @id @default(cuid())
  orgId           String
  name            String
  email           String
  role            String    @default("Manager") // Owner | Admin | Manager | Viewer
  department      String?
  userId          String? // set once the invited person accepts and has a real login
  status          String    @default("PENDING") // PENDING | ACTIVE | REVOKED
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?
  invitedAt       DateTime  @default(now())
  acceptedAt      DateTime?

  org  EnterpriseOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([orgId, email])
  @@index([orgId])
  @@index([userId])
  @@index([inviteToken])
}

model EnterpriseApiKey {
  id         String    @id @default(cuid())
  orgId      String
  keyPrefix  String // first 8 chars shown in UI, full key hashed
  keyHash    String
  label      String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  org EnterpriseOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model EnterpriseAuditLog {
  id        String   @id @default(cuid())
  orgId     String
  userId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  org EnterpriseOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([createdAt])
}

model JobApplication {
  id          String   @id @default(cuid())
  role        String // job title applied for, or "Open Application"
  name        String
  email       String
  phone       String?
  linkedin    String? // LinkedIn profile URL
  resumeUrl   String? // uploaded resume link (S3/Cloudflare)
  coverLetter String? // free-text cover letter
  source      String? // how they heard about GridGuide
  status      String   @default("NEW") // NEW | REVIEWING | INTERVIEW | OFFER | REJECTED | WITHDRAWN
  notes       String? // internal admin notes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([role])
  @@index([createdAt])
}

model EnterpriseImportBatch {
  id          String    @id @default(cuid())
  orgId       String
  fileName    String?
  totalRows   Int       @default(0)
  imported    Int       @default(0)
  skipped     Int       @default(0)
  errors      Int       @default(0)
  status      String    @default("PENDING") // PENDING | PROCESSING | COMPLETE | FAILED
  errorLog    Json?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  org     EnterpriseOrg               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invites EnterpriseHomeownerInvite[]

  @@index([orgId])
}

model EnterpriseCampaign {
  id          String         @id @default(cuid())
  orgId       String
  name        String
  subject     String
  body        String?
  status      CampaignStatus @default(DRAFT)
  sentCount   Int            @default(0)
  openCount   Int            @default(0)
  clickCount  Int            @default(0)
  signupCount Int            @default(0)
  scheduledAt DateTime?
  sentAt      DateTime?
  failedCount Int            @default(0)
  queuedAt    DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  org     EnterpriseOrg               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invites EnterpriseHomeownerInvite[]

  @@index([orgId])
}

// ── Email suppression list ────────────────────────────────────────────────────
model EmailSuppression {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String // UNSUBSCRIBE | BOUNCE | COMPLAINT | ADMIN | EXPIRED
  source    String? // installer-invite | enterprise-invite | marketing | webhook
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// ── Per-email unsubscribe tokens ──────────────────────────────────────────────
model UnsubscribeToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique @default(cuid())
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([token])
}

// ── Durable delivery job — replaces inline HTTP send loop ────────────────────
model InvitationDeliveryJob {
  id             String    @id @default(cuid())
  invitationType String // INSTALLER | ENTERPRISE_HOMEOWNER | SELLER_MESSAGE | SELLER_TEAM_INVITE | PARTNER_INVITATION | PROPOSAL
  invitationId   String // InstallerCustomerInvite.id or EnterpriseHomeownerInvite.id
  campaignId     String? // null for standalone invites
  recipientEmail String
  status         String    @default("PENDING") // PENDING|QUEUED|SENDING|SENT|FAILED|SKIPPED|SUPPRESSED
  attempts       Int       @default(0)
  lastError      String?
  providerId     String? // provider message-id for dedup/tracking
  availableAt    DateTime  @default(now())
  processedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Unique only when campaignId is set; standalone jobs use invitationId alone
  @@index([invitationType, invitationId, campaignId])
  @@index([status, availableAt])
  @@index([campaignId])
  @@index([recipientEmail])
}

// ═══════════════════════════════════════════════════════════════════════════════
// SELLER COMMUNICATION SYSTEM — Phase 1 + 2
// ═══════════════════════════════════════════════════════════════════════════════

enum SellerCampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  SENDING
  SENT
  PARTIAL
  FAILED
  PAUSED
  CANCELLED
}

enum SellerMessageType {
  ORDER_CONFIRMATION
  PAYMENT_RECEIVED
  ORDER_PROCESSING
  ORDER_SHIPPED
  ORDER_DELIVERED
  RETURN_AUTHORIZED
  REFUND_ISSUED
  REVIEW_REQUEST
  PRODUCT_ANNOUNCEMENT
  PROMOTIONAL_CAMPAIGN
  BACK_IN_STOCK
  PRICE_DROP
  QUOTE
  SUPPORT
  TEAM_INVITE
}

// ── Seller customers with consent tracking ────────────────────────────────────
model SellerCustomer {
  id                         String    @id @default(cuid())
  sellerId                   String
  userId                     String? // null = non-GridGuide customer
  email                      String
  firstName                  String?
  lastName                   String?
  phone                      String?
  address                    String?
  city                       String?
  state                      String?
  zip                        String?
  marketingOptIn             Boolean   @default(false)
  marketingOptInAt           DateTime?
  marketingOptOutAt          DateTime?
  source                     String? // marketplace | import | manual | referral
  totalOrders                Int       @default(0)
  lifetimeValue              Float     @default(0)
  lastOrderAt                DateTime?
  lastContactAt              DateTime?
  notes                      String?
  // Consent evidence — required for compliance
  marketingConsentSource     String? // web-form | import | checkout | manual
  marketingConsentText       String? // exact consent language shown to customer
  marketingConsentIp         String?
  marketingConsentRecordedBy String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  seller    Seller                    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  campaigns SellerCampaignRecipient[]
  quotes    SellerQuote[]
  messages  SellerMessageLog[]

  @@unique([sellerId, email])
  @@index([sellerId, marketingOptIn])
  @@index([sellerId, lastOrderAt])
}

// ── Seller campaigns ──────────────────────────────────────────────────────────
model SellerCampaign {
  id              String               @id @default(cuid())
  sellerId        String
  createdByUserId String
  name            String
  subject         String
  bodyHtml        String
  bodyText        String?
  type            String               @default("PROMOTIONAL_CAMPAIGN")
  status          SellerCampaignStatus @default(DRAFT)
  segmentJson     Json?
  scheduledAt     DateTime?
  queuedAt        DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  sentAt          DateTime?
  failedAt        DateTime?
  recipientCount  Int                  @default(0)
  sentCount       Int                  @default(0)
  openedCount     Int                  @default(0)
  clickedCount    Int                  @default(0)
  convertedCount  Int                  @default(0)
  failedCount     Int                  @default(0)
  suppressedCount Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  seller      Seller                     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  recipients  SellerCampaignRecipient[]
  conversions SellerCampaignConversion[]

  @@index([sellerId, status])
  @@index([scheduledAt, status])
}

model SellerCampaignRecipient {
  id             String    @id @default(cuid())
  campaignId     String
  customerId     String?
  email          String
  firstName      String?
  lastName       String?
  status         String    @default("PENDING")
  queuedAt       DateTime?
  sentAt         DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  convertedAt    DateTime?
  failedAt       DateTime?
  sendAttempts   Int       @default(0)
  lastAttemptAt  DateTime?
  lastSendError  String?
  providerId     String?
  unsubscribeKey String?   @unique @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  campaign         SellerCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  SellerCustomer   SellerCustomer? @relation(fields: [sellerCustomerId], references: [id])
  sellerCustomerId String?

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([email])
}

model SellerCampaignConversion {
  id           String   @id @default(cuid())
  campaignId   String
  recipientId  String
  orderId      String
  revenue      Float
  attributedAt DateTime @default(now())
  method       String   @default("LAST_CLICK")

  campaign SellerCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, orderId])
  @@index([campaignId, attributedAt])
}

// ── Message log — all seller outbound comms ───────────────────────────────────
model SellerMessageLog {
  id              String            @id @default(cuid())
  sellerId        String
  customerId      String?
  orderId         String?
  quoteId         String?
  campaignId      String?
  type            SellerMessageType
  toEmail         String
  subject         String
  providerId      String?
  status          String            @default("PENDING")
  sentAt          DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  failedAt        DateTime?
  errorMessage    String?
  createdByUserId String?
  createdAt       DateTime          @default(now())

  seller   Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  customer SellerCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([sellerId, toEmail])
  @@index([orderId])
  @@index([campaignId])
  @@index([sellerId, type])
}

// ── Quotes and proposals ──────────────────────────────────────────────────────
model SellerQuote {
  id               String    @id @default(cuid())
  sellerId         String
  customerId       String?
  createdByUserId  String
  quoteNumber      String    @unique
  status           String    @default("DRAFT") // DRAFT|SENT|VIEWED|ACCEPTED|DECLINED|EXPIRED
  subtotal         Float     @default(0)
  discountAmount   Float     @default(0)
  taxAmount        Float     @default(0)
  shippingAmount   Float     @default(0)
  total            Float     @default(0)
  expiresAt        DateTime?
  sentAt           DateTime?
  viewedAt         DateTime?
  acceptedAt       DateTime?
  declinedAt       DateTime?
  convertedOrderId String?
  notes            String?
  lineItemsJson    Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  seller   Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  customer SellerCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([sellerId, status])
  @@index([sellerId, createdAt])
}

// ── Team invitations ──────────────────────────────────────────────────────────
model SellerTeamInvite {
  id            String         @id @default(cuid())
  sellerId      String
  email         String
  role          SellerTeamRole @default(VIEWER)
  token         String         @unique @default(cuid())
  status        String         @default("PENDING") // PENDING|ACCEPTED|DECLINED|EXPIRED
  expiresAt     DateTime
  sentAt        DateTime?
  acceptedAt    DateTime?
  sendAttempts  Int            @default(0)
  lastAttemptAt DateTime?
  lastSendError String?
  providerId    String?
  createdById   String
  createdAt     DateTime       @default(now())

  @@unique([sellerId, email])
  @@index([sellerId, status])
  @@index([token])
}

// ── Admin communication policy ────────────────────────────────────────────────
model SellerCommunicationPolicy {
  id                        String   @id @default("singleton")
  campaignsEnabled          Boolean  @default(true)
  freeMonthlyRecipientLimit Int      @default(0)
  proMonthlyRecipientLimit  Int      @default(5000)
  enterpriseRecipientLimit  Int?
  maxDailyRecipients        Int      @default(1000)
  requireVerifiedSender     Boolean  @default(true)
  reviewFlaggedCampaigns    Boolean  @default(true)
  updatedAt                 DateTime @updatedAt
}

// ── Shared campaign status enum ───────────────────────────────────────────────
enum CampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  SENDING
  SENT
  PARTIAL
  FAILED
  PAUSED
  CANCELLED
}

// ── Seller team membership ────────────────────────────────────────────────────
enum SellerTeamRole {
  OWNER
  MANAGER
  SUPPORT
  VIEWER
}

model SellerTeamMember {
  id        String         @id @default(cuid())
  sellerId  String
  userId    String
  role      SellerTeamRole
  status    String         @default("ACTIVE") // ACTIVE | SUSPENDED
  joinedAt  DateTime       @default(now())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sellerId, userId])
  @@index([sellerId, role])
}

// ─── Partner Invitation System ────────────────────────────────────────────────
// Admin-controlled onboarding of installer companies, enterprise orgs, sellers.
// Separate from InstallerCustomerInvite / EnterpriseHomeownerInvite / SellerTeamInvite.

enum PartnerInvitationType {
  INSTALLER
  ENTERPRISE
  SELLER
}

enum PartnerInvitationStatus {
  DRAFT
  SENT
  OPENED
  ACCEPTED
  EXPIRED
  CANCELLED
  APPROVED
  REJECTED
}

model PartnerInvitation {
  id     String                  @id @default(cuid())
  type   PartnerInvitationType
  status PartnerInvitationStatus @default(DRAFT)

  // Contact
  email       String
  contactName String?
  companyName String
  phone       String?
  website     String?

  // Commercial config assigned by admin at invite time
  assignedPlan      String?
  commissionRate    Float?
  successFeeRate    Float?
  subscriptionShare Float?
  vppInstallerShare Float?

  // Seller-only onboarding config
  marketplaceCategory    String?
  shippingRequired       Boolean @default(false)
  stripeConnectRequired  Boolean @default(true)
  taxInfoRequired        Boolean @default(true)
  sellerAgreementVersion String?

  // Enterprise-only onboarding config
  expectedPropertyCount Int?
  sponsoredHomeowners   Boolean @default(false)

  // Installer-only onboarding config
  serviceStates   String[]
  licenseRequired Boolean  @default(true)

  // Token lifecycle
  token       String    @unique @default(cuid())
  expiresAt   DateTime
  sentAt      DateTime?
  openedAt    DateTime?
  acceptedAt  DateTime?
  approvedAt  DateTime?
  rejectedAt  DateTime?
  cancelledAt DateTime?

  // Delivery tracking
  resendCount   Int       @default(0)
  lastSentAt    DateTime?
  lastSendError String?

  // Actor references (string IDs only — no hard FK until schema review)
  invitedByUserId  String
  acceptedByUserId String?
  approvedByUserId String?

  // Linked records after approval
  installerId     String?
  enterpriseOrgId String?
  sellerId        String?

  internalNote String?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type, status])
  @@index([email])
  @@index([companyName])
  @@index([expiresAt])
  @@index([invitedByUserId])
}
