model PlatformConfig {
  id String @id @default("singleton") // only one row ever

  // ── Installer revenue share by plan ──────────────────────────────────────
  installerShareFree       Float @default(0.15) // 15% — Free plan
  installerSharePro        Float @default(0.25) // 25% — Pro plan
  installerShareEnterprise Float @default(0.30) // 30% — Enterprise plan

  // ── Installer success fee by plan (on each job) ───────────────────────────
  successFeeFree       Float @default(0.10) // 10%
  successFeePro        Float @default(0.07) // 7%
  successFeeEnterprise Float @default(0.05) // 5%

  // ── Installer membership (monthly SaaS fee) ───────────────────────────────
  membershipFeeFree       Float @default(0) // $0
  membershipFeePro        Float @default(99) // $99/mo
  membershipFeeEnterprise Float @default(499) // $499/mo

  // ── Credit economics ──────────────────────────────────────────────────────
  creditsPerDollar            Int   @default(1000) // 1,000 credits = $1.00
  homeownerReferralCredits    Int   @default(2500) // one-time credit award per successful referral (= $2.50)
  monthlyRedemptionCapCredits Int   @default(2500) // max credits redeemable toward subscription per month (= $2.50)
  monthlyRedemptionCapDollars Float @default(2.50) // mirrors the cap above in dollars for display/validation

  // ── Grid Fund donation ─────────────────────────────────────────────────────
  // ── Installer lead success fees (tiered by plan, admin-adjustable) ──────────
  leadSuccessFeeFree         Float @default(0.10) // 10% — Free plan
  leadSuccessFeePro          Float @default(0.07) // 7%  — Pro plan
  leadSuccessFeeEnterprise   Float @default(0.05) // 5%  — Enterprise plan

  // Installer VPP projection — an ASSUMPTION used only for the "projected per
  // event" figure on the installer VPP earnings view. Never used in settlement.
  vppProjectedPerEventRate   Float @default(5) // $ per enrolled referred home per event
  // Donations are sourced from the cash wallet (VPP earnings), NOT Credits.
  // The homeowner earns gridFundDonationBonusPct of the donated dollar value
  // back as GridGuide Credits (converted at creditsPerDollar).
  gridFundDonationMinDollars Float @default(1.00) // $1.00 minimum per donation
  gridFundDonationBonusPct   Float @default(0.10) // 10% of donated $ value, paid back in credits

  // ── Community Impact page (public, GridGuideEnergy marketing site) ─────────
  publicDonationCounterEnabled Boolean  @default(true)
  donationDisplayMode          String   @default("campaign") // "lifetime" | "campaign"
  communityGoalLabel           String   @default("Community Donation Goal")
  communityGoalTargetAmount    Float    @default(100000)
  communityGoalStartDate       DateTime @default(now()) // campaign totals only count donations after this date; reset by updating this
  // @deprecated — superseded by the dollar-based fields above; retained for
  // historical data only, do not use in new code.
  gridFundDonationMinCredits   Int      @default(1000)
  gridFundDonationBonusCredits Int      @default(25)

  // ── Homeowner subscription pricing (admin adjustable) ─────────────────────
  homeownerSubscriptionPrice Float @default(9.99) // monthly price for GridGuide Pro (homeowner) — legacy

  // ── Subscription pricing — all 4 prices for accurate commission calculation ──
  plusMonthly Float @default(9.99) // Plus monthly billing price
  plusAnnual  Float @default(8.29) // Plus annual billing (monthly equivalent)
  proMonthly  Float @default(19.99) // Pro monthly billing price
  proAnnual   Float @default(16.59) // Pro annual billing (monthly equivalent)

  // ── Membership mix assumptions — forecast/display only, never affects real payouts ──
  pctPlus   Float @default(0.70) // forecast % of subs on Plus vs Pro
  pctAnnual Float @default(0.30) // forecast % of subs on annual vs monthly

  // ── VPP event revenue split, by installer plan tier ───────────────────────
  // Each row totals 100%. Free installers get 0% — they still earn referral
  // commission on the subscription itself, just not on VPP event payouts.
  vppSplitFreeHomeowner Float @default(0.80) // 80%
  vppSplitFreeGridguide Float @default(0.20) // 20%
  vppSplitFreeInstaller Float @default(0.00) //  0%

  vppSplitProHomeowner Float @default(0.75) // 75%
  vppSplitProGridguide Float @default(0.20) // 20%
  vppSplitProInstaller Float @default(0.05) //  5%

  vppSplitEnterpriseHomeowner Float @default(0.75) // 75%
  vppSplitEnterpriseGridguide Float @default(0.15) // 15%
  vppSplitEnterpriseInstaller Float @default(0.10) // 10%

  // ── Seller commission ─────────────────────────────────────────────────────
  sellerCommissionFree Float @default(0.10) // 10%
  sellerCommissionPro  Float @default(0.08) // 8%

  // ── GridGuide platform fees ───────────────────────────────────────────────
  marketplaceFee Float @default(0.03) // 3% on marketplace orders
  withdrawalFee  Float @default(0.00) // $0 default

  updatedAt DateTime @updatedAt
  updatedBy String? // admin userId who last changed it
}

