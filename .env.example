# ═══════════════════════════════════════════════════════════════════════════════
# GRIDGUIDE — ENVIRONMENT VARIABLES
# Copy to .env.local for dev, or set directly in your hosting provider for prod.
#
# Every variable below is cross-checked against actual `process.env.X` usage in
# the codebase (see scripts/verify-env.js, which enforces this at deploy time).
# Previous versions of this file had several NAME MISMATCHES with the code
# (e.g. STRIPE_INSTALLER_PRO_PRICE_ID here vs STRIPE_PRICE_INSTALLER_PRO in
# lib/stripe.js) — those are fixed below. If you had a real .env based on the
# old names, rename the keys accordingly before deploying.
# ═══════════════════════════════════════════════════════════════════════════════

# ── REQUIRED — the app will not start correctly without these ──────────────────

# Postgres connection string
DATABASE_URL="postgresql://gridguide:password@localhost:5432/gridguide?schema=public"
# Supabase: postgresql://postgres:[password]@[host]:5432/postgres
# Railway:  postgresql://postgres:[password]@[host]:5432/railway

# JWT signing secrets. In production, lib/jwt.js and middleware.js both FAIL AT
# STARTUP if these are unset — generate real random values, don't leave blank.
#   openssl rand -base64 48
JWT_SECRET="change-this-to-a-64-char-random-string-in-production"
JWT_REFRESH_SECRET="change-this-to-a-different-64-char-random-string"

# Protects POST/GET /api/cron and /api/cron/installer-commissions (Vercel Cron
# or your scheduler must send `Authorization: Bearer $CRON_SECRET`). Also
# FAILS CLOSED in production if unset — these jobs trigger real payouts.
#   openssl rand -hex 32
CRON_SECRET=""

# Signs internal service-to-service calls (see lib/python-client.js)
INTERNAL_API_SECRET=""

# ── STRIPE (required for any paid plan or marketplace checkout) ────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# One Price ID per paid tier, created in the Stripe Dashboard. Read by lib/stripe.js.
STRIPE_PRICE_CONSUMER_PRO=""
STRIPE_PRICE_CONSUMER_ENTERPRISE=""
STRIPE_PRICE_SELLER_PRO=""
STRIPE_PRICE_INSTALLER_PRO=""
STRIPE_PRICE_INSTALLER_ENTERPRISE=""  # Installer Enterprise plan ($499/mo)
STRIPE_PRICE_ENTERPRISE_BASIC=""
STRIPE_PRICE_ENTERPRISE_PRO=""
STRIPE_PRICE_ENTERPRISE_SCALE=""
STRIPE_PRICE_ENTERPRISE_BASIC_ANNUAL=""
STRIPE_PRICE_ENTERPRISE_PRO_ANNUAL=""
STRIPE_PRICE_ENTERPRISE_SCALE_ANNUAL=""
STRIPE_PRICE_ENTERPRISE_SPONSORED_SEAT=""

# ── REDIS (rate limiting, caching, background job coordination) ────────────────
REDIS_URL="redis://localhost:6379"
# Upstash: rediss://:[password]@[host]:6379
# Set to "true" to force in-memory fallback instead of Redis (dev/CI only —
# rate limits and caches won't be shared across instances).
SKIP_REDIS="false"

# ── EMAIL (SendGrid) ─────────────────────────────────────────────────────────
SENDGRID_API_KEY="SG...."
FROM_EMAIL="noreply@gridguide.ai"
SALES_NOTIFY_EMAIL="sales@gridguide.ai"   # where Enterprise "request access" leads land

# ── SMS (Twilio) — optional, only needed if SMS notifications are enabled ─────
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1..."

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── UTILITY / ENERGY DATA ────────────────────────────────────────────────────
UTILITYAPI_KEY=""
DERAPI_KEY=""            # DER devices (solar, battery, EV chargers) — see lib/vpp-partners.js docs
DERAPI_THERMOSTAT_KEY="" # Thermostats via Derapi's normalized thermostat API
ENERGYHUB_API_KEY=""

# VPP demand-response partners — each provider resolves its own env vars
# dynamically as `${PROVIDER}_API_KEY` / `_API_BASE_URL` / `_WEBHOOK_SECRET`
# (see lib/vpp-partners.js VPP_PROVIDER_CONFIG). Webhook secrets FAIL CLOSED
# in production if unset (see app/api/vpp/webhooks/[provider]/route.js).
LEAP_API_KEY=""
LEAP_API_BASE_URL="https://api.leap.energy"
LEAP_WEBHOOK_SECRET=""
ENEL_API_KEY=""
ENEL_API_BASE_URL="https://api.enelx.com"
ENEL_WEBHOOK_SECRET=""

# ── MAPS / GEO ────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=""     # server-side geocoding/places
NEXT_PUBLIC_MAPBOX_TOKEN="pk.eyJ1..."  # client-side map rendering
MAPBOX_SECRET_TOKEN=""     # server-side Mapbox calls (if used beyond the public token)

# ── FILE STORAGE (S3-compatible) ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="us-east-1"
AWS_S3_BUCKET="gridguide-uploads"
AWS_CDN_URL=""  # optional — CloudFront/CDN URL in front of the bucket; falls back to the raw S3 URL

# ── SMART THERMOSTATS (each is optional — only needed for that brand's OAuth) ──
ECOBEE_CLIENT_ID=""
ECOBEE_CLIENT_SECRET=""
GOOGLE_SDM_CLIENT_ID=""
GOOGLE_SDM_SECRET=""
GOOGLE_SDM_PROJECT_ID=""
HONEYWELL_CONSUMER_KEY=""
HONEYWELL_CONSUMER_SECRET=""
SMARTTHINGS_CLIENT_ID=""
SMARTTHINGS_CLIENT_SECRET=""
AMAZON_LWA_CLIENT_ID=""
AMAZON_LWA_CLIENT_SECRET=""

# ── PYTHON MICROSERVICE (energy forecasting) — optional, has a localhost fallback ─
PYTHON_SERVICE_URL="http://localhost:8001"

# ── MONITORING ────────────────────────────────────────────────────────────────
SENTRY_DSN="https://...@sentry.io/..."

# ── APP URLS ─────────────────────────────────────────────────────────────────
# The canonical app domain — every backend callback, webhook redirect, and
# email link in this codebase defaults to https://gridguide.ai if this isn't
# set. GridGuideEnergy.com is the marketing-site branding shown by the same
# deployment (the in-app site switcher toggles between the two experiences
# client-side) — it is not a separate URL anything in the backend needs to
# know about.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_VERSION="1.0.0"

# ── MISC ──────────────────────────────────────────────────────────────────────
DEBUG="false"
NODE_ENV="development"   # set to "production" by your host — do not hardcode this in production configs

# ── NOT CURRENTLY READ BY THE CODEBASE ──────────────────────────────────────────
# These were present in earlier versions of this file but nothing in the app
# reads them today (grep-verified). Left here as a note in case a future
# feature (e.g. NextAuth, client-side Stripe Elements, a Sentry browser
# widget, or per-subdomain URLs) reintroduces the need for them — don't spend
# time debugging "why isn't this used" during deployment.
#   NEXTAUTH_SECRET, NEXTAUTH_URL, STRIPE_PUBLISHABLE_KEY,
#   NEXT_PUBLIC_SENTRY_DSN, NEXT_PUBLIC_ENERGY_URL, NEXT_PUBLIC_AI_URL

# ── GREEN BUTTON CONNECT MY DATA ─────────────────────────────────────────────
# Green Button Alliance developer program credentials.
# Register at: https://www.greenbuttonalliance.org/developer
# These are required for the OAuth 2.0 token exchange with utility "Share My
# Data" portals. Each major utility also requires a separate registration.
GREEN_BUTTON_CLIENT_ID="your_gbc_client_id"
GREEN_BUTTON_CLIENT_SECRET="your_gbc_client_secret"

# Seller Enterprise plan Stripe price ID
STRIPE_PRICE_SELLER_ENTERPRISE=""

# Feature flags
ENABLE_LEGACY_VPP_DISPATCH="false"    # keep false — uses partner model (Leap/Enel)
